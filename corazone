<!--
  animacion_corazones.html
  Guarda este archivo y ábrelo en Visual Studio Code -> clic derecho -> "Open with Live Server" o abrir en el navegador.
  Contiene animación de corazones flotantes. Haz click o toca la pantalla para generar más corazones.
-->

<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Animación de Corazones</title>
  <style>
    :root{
      --bg1: #ff9a9e;
      --bg2: #fad0c4;
      --accent: #ff4d6d;
      --soft: rgba(255,77,109,0.12);
    }
    html,body{height:100%;margin:0;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial}
    body{
      display:flex;align-items:center;justify-content:center;
      background: linear-gradient(135deg, var(--bg1) 0%, var(--bg2) 100%);
      overflow:hidden;
      color:white;
    }

    .stage{
      position:relative; width:100%; height:100vh; max-width:1200px; padding:40px; box-sizing:border-box;
      display:flex;flex-direction:column;gap:20px;align-items:center;justify-content:center;
    }

    h1{
      font-size:clamp(1.6rem, 3.5vw, 2.6rem);
      margin:0 0 8px 0;text-align:center;letter-spacing:0.6px;
      text-shadow:0 6px 18px rgba(0,0,0,0.18);
    }
    p.lead{margin:0 0 20px 0;opacity:0.95;text-align:center;max-width:820px}

    /* Contenedor donde aparecerán los corazones */
    .sky{position:absolute;inset:0;pointer-events:auto;}

    /* Estilo del botón */
    .controls{z-index:50;display:flex;gap:10px;align-items:center}
    .btn{
      background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);
      padding:10px 14px;border-radius:12px;color:white;backdrop-filter: blur(6px);
      cursor:pointer;font-weight:600
    }
    .btn:active{transform:translateY(1px)}

    /* Heart shape using pseudo elements */
    .heart{
      position:absolute; width:48px; height:48px; transform:translate(-50%,0) rotate(-45deg);
      transform-origin:50% 50%;
      pointer-events:none; z-index:10;
    }
    .heart .pill{position:absolute; width:48px; height:48px; background:var(--accent); border-radius:50%; top:0; left:0}
    .heart::before, .heart::after{
      content:''; position:absolute; width:48px; height:48px; background:var(--accent); border-radius:50%;
    }
    .heart::before{top:-24px; left:0}
    .heart::after{left:24px; top:0}

    /* Slight glow */
    .heart::after, .heart::before, .heart .pill{box-shadow:0 6px 18px var(--soft)}

    /* Animations */
    @keyframes floatUp {
      0%{transform:translate(-50%,0) rotate(-45deg) scale(0.8); opacity:0}
      10%{opacity:1}
      100%{transform:translate(-50%,-120vh) rotate(20deg) scale(1); opacity:0}
    }

    @keyframes beat {
      0%{transform:rotate(-45deg) scale(1)}
      25%{transform:rotate(-45deg) scale(1.08)}
      45%{transform:rotate(-45deg) scale(0.98)}
      70%{transform:rotate(-45deg) scale(1.04)}
      100%{transform:rotate(-45deg) scale(1)}
    }

    /* small responsive hint */
    .hint{opacity:0.95;font-size:0.9rem}

    /* footer credit */
    .credit{position:absolute;left:12px;bottom:12px;font-size:0.8rem;opacity:0.7}

  </style>
</head>
<body>
  <div class="stage">
    <div style="text-align:center;z-index:60;">
      <h1>Código de Amor — Animación de Corazones</h1>
      <p class="lead">Haz click o toca la pantalla para crear corazones. También puedes usar el botón para generar una lluvia romántica.</p>
      <div class="controls">
        <button id="rainBtn" class="btn">Lluvia de corazones</button>
        <button id="clearBtn" class="btn">Borrar</button>
        <span class="hint">Click / tocar para generar 1 ♥</span>
      </div>
    </div>

    <div id="sky" class="sky" aria-hidden="true"></div>

    <div class="credit">Creado con ❤️ — Abre en Visual Studio Code</div>
  </div>

  <script>
    const sky = document.getElementById('sky');
    const rainBtn = document.getElementById('rainBtn');
    const clearBtn = document.getElementById('clearBtn');

    // Genera un corazón en (x,y) relativos (px)
    function spawnHeart(x, y, opts = {}){
      const heart = document.createElement('div');
      heart.className = 'heart';

      // tamaño aleatorio
      const size = opts.size ?? (20 + Math.random()*60);
      heart.style.width = size + 'px';
      heart.style.height = size + 'px';
      heart.style.left = x + 'px';
      heart.style.top = y + 'px';

      // color variado
      const hue = opts.hue ?? (330 - Math.random()*40);
      heart.style.setProperty('--accent', `hsl(${hue}deg 85% 57%)`);
      heart.style.setProperty('--soft', `rgba(255,77,109,0.14)`);

      // Apply inner pill (fix for correct layering cross-browser)
      const pill = document.createElement('div'); pill.className='pill';
      heart.appendChild(pill);

      // animation duration random
      const duration = 6 + Math.random()*6; // seconds
      heart.style.animation = `floatUp ${duration}s linear forwards`;

      // small beat animation delay
      const beatDelay = Math.random()*0.6;
      heart.style.animation += `, none 0s`; // ensure other anims exist
      heart.style.setProperty('animation', `floatUp ${duration}s linear forwards`);

      // add slight pulsing (using setInterval) or CSS transform
      heart.style.transition = 'transform 0.12s ease-out';
      heart.style.willChange = 'transform,opacity';

      // add a tiny CSS-based repeating beat using an inline style
      const beatDur = 1.6 + Math.random()*0.8;
      heart.style.setProperty('animation', `floatUp ${duration}s linear forwards`);
      heart.style.setProperty('transform', 'rotate(-45deg)');
      heart.style.setProperty('animationName', 'floatUp');

      // random horizontal drift using CSS variable and transform in keyframes (we'll simulate via JS)
      const drift = (Math.random()*140 - 70) + 'px';

      // attach to DOM
      sky.appendChild(heart);

      // animate horizontal drift and heartbeat using requestAnimationFrame
      const startTop = parseFloat(heart.style.top);
      const startLeft = parseFloat(heart.style.left);
      const startTime = performance.now();

      function frame(now){
        const t = (now - startTime) / (duration*1000);
        if(t > 1){
          heart.remove();
          return;
        }
        // vertical position is handled by CSS animation; we only apply small horizontal drift + beat scale
        const dx = (parseFloat(drift) * easeInOutQuad(t));
        heart.style.transform = `translate(calc(-50% + ${dx}px), 0) rotate(${-45 + t*60}deg) scale(${1 + 0.06*Math.sin(t*8*Math.PI)})`;
        requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);

      // helper easing
      function easeInOutQuad(x){return x<0.5?2*x*x:1 - Math.pow(-2*x+2,2)/2}

      // remove after duration+buffer
      setTimeout(()=>heart.remove(), (duration+0.2)*1000);

      return heart;
    }

    // Click/tap to spawn
    sky.addEventListener('pointerdown', function(e){
      // coordinates relative to sky
      const rect = sky.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      spawnHeart(x, y, {size: 26 + Math.random()*36});
    });

    // Rain of hearts
    let raining = false;
    let rainInterval = null;
    rainBtn.addEventListener('click', ()=>{
      if(raining){
        raining = false; rainBtn.textContent = 'Lluvia de corazones';
        clearInterval(rainInterval); rainInterval = null; return;
      }
      raining = true; rainBtn.textContent = 'Detener lluvia';
      let count = 0;
      rainInterval = setInterval(()=>{
        const rect = sky.getBoundingClientRect();
        // spawn at random x at bottom
        for(let i=0;i<4;i++){
          const x = Math.random()*rect.width;
          const y = rect.height - 10;
          spawnHeart(x, y, {size: 12 + Math.random()*60});
        }
        count++;
        if(count > 120){ // auto stop after many iterations
          clearInterval(rainInterval); rainInterval = null; raining = false; rainBtn.textContent = 'Lluvia de corazones';
        }
      }, 220);
    });

    clearBtn.addEventListener('click', ()=>{ sky.innerHTML = ''; });

    // auto gentle spawn (background breathing)
    setInterval(()=>{
      const rect = sky.getBoundingClientRect();
      const x = Math.random()*rect.width;
      const y = rect.height - 6;
      spawnHeart(x,y,{size: 14 + Math.random()*40});
    }, 1400);

    // Accessibility: support keyboard
    window.addEventListener('keydown', (e)=>{
      if(e.code === 'Space'){
        const rect = sky.getBoundingClientRect();
        spawnHeart(rect.width/2, rect.height/2, {size: 48});
      }
    });

  </script>
</body>
</html>
